    {
      "id": 7,
      "type": "stat",
      "title": "GPU energy, selected range",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 20,
        "y": 3,
        "w": 4,
        "h": 2
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum_over_time((sum(max by (gpu) (DCGM_FI_DEV_POWER_USAGE)))[$__range:1m]) * 60 / 3600000",
          "legendFormat": "Energy",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
