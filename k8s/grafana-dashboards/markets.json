        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 16,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "description": "Long-term figures are computed by the exporter from Yahoo Finance daily closes (10 years), so they don't depend on Prometheus' 10-day memory.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (name, group) (market_change_percent{period=\"1d\",name!~\"VIX.*\",group=~\"$group\"})",
          "legendFormat": "{{name}}",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (name, group) (market_change_percent{period=\"1w\",name!~\"VIX.*\",group=~\"$group\"})",
          "legendFormat": "{{name}}",
