        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (name, group) (market_volatility_30d_percent{name!~\"VIX.*\",group=~\"$group\"})",
          "legendFormat": "{{name}}",
          "refId": "K",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "Today",
              "Value #B": "1 week",
              "Value #C": "1 month",
              "Value #D": "3 months",
              "Value #E": "YTD",
              "Value #F": "1 year",
              "Value #G": "5 years",
              "Value #H": "From 5y high",
              "Value #I": "52w range",
              "Value #J": "vs 200-day avg",
              "Value #K": "Volatility 30d"
